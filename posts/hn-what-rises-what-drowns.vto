  /* horizontal bars */
  .hbars { display: grid; grid-template-columns: minmax(118px, max-content) 1fr; row-gap: 7px; column-gap: 12px; }
  .hb-label {
    font-size: 13.5px; color: var(--ink-2);
    align-self: center; text-align: right;
